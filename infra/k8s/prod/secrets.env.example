# Copy this file to secrets.env and set real values locally.
# secrets.env is gitignored and must never be committed.
# See docs/secrets-bootstrap-rotation.md.

# One or two comma-separated SHA-256 hashes of the bearer token.
# Generate both with: go run ./src/tools/ssm-secrets token
MCP_TOKEN_SHA256=
PAPRIKA_EMAIL=
PAPRIKA_PASSWORD=
